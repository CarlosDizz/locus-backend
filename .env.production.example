# Docker Compose keeps the existing V1 MySQL volume and creates a separate locus_v2 database.
MYSQL_ROOT_PASSWORD=replace-me
DB_NAME=locus
DB_USER=locus
DB_PASSWORD=replace-me

LOCUS_ENV=production
LOCUS_LOG_LEVEL=INFO
LOCUS_DATABASE_URL=mysql+asyncmy://locus:replace-me@mysql:3306/locus_v2
LOCUS_LEGACY_DATABASE_URL=mysql+pymysql://locus:replace-me@mysql:3306/locus
LOCUS_REDIS_URL=redis://valkey:6379/0
LOCUS_JWT_SECRET=replace-with-at-least-32-random-characters
LOCUS_ADMIN_EMAIL=dizz01@gmail.com
LOCUS_ALLOW_INSECURE_LOCAL_ADMIN=false
LOCUS_ADMIN_SESSION_COOKIE=locus_admin_session
LOCUS_GOOGLE_AUTH_CLIENT_IDS=[]
LOCUS_CORS_ORIGINS=["https://api.locusguide.es","https://admin.locusguide.es","capacitor://localhost","ionic://localhost","http://localhost","http://localhost:8100","http://localhost:8200","https://localhost"]
LOCUS_PUBLIC_API_BASE_URL=https://api.locusguide.es/api

LOCUS_OPENAI_API_KEY=
LOCUS_GEMINI_API_KEY=
LOCUS_MAPS_API_KEY=
LOCUS_GETYOURGUIDE_PARTNER_ID=
LOCUS_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
LOCUS_GOOGLE_PLAY_PACKAGE_NAME=com.carlos.locusia
LOCUS_GOOGLE_PLAY_VERIFY_PURCHASES=true

LOCUS_BILLING_USD_TO_EUR=0.87
LOCUS_BILLING_MARGIN_MULTIPLIER=2.20
LOCUS_BILLING_MIN_REALTIME_CALL_CHARGE_CENTS=3
LOCUS_BILLING_SIGNUP_BONUS_CENTS=200
LOCUS_BILLING_MANUAL_TOPUPS_ENABLED=true
LOCUS_APP_ANDROID_LATEST_VERSION_CODE=10
LOCUS_APP_ANDROID_UPDATE_URL=https://play.google.com/store/apps/details?id=com.carlos.locusia
